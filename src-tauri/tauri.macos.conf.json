{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "fileAssociations": [
      { "ext": ["md", "markdown"], "contentTypes": ["net.daringfireball.markdown"], "role": "Viewer", "rank": "Alternate" },
      { "ext": ["html", "htm"], "contentTypes": ["public.html"], "role": "Viewer", "rank": "Alternate" }
    ]
  },
  "app": {
    "windows": [
      {
        "title": "mycmux",
        "width": 1200,
        "height": 800,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  }
}
